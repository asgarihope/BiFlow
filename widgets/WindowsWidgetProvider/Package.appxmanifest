<?xml version="1.0" encoding="utf-8"?>
<!--
  BiFlow Windows 11 Widgets Board package.

  This manifest is what turns an ordinary executable into a *packaged*
  third-party widget. The two declarations that matter are:

    1. <Extensions> -> <uap3:AppExtension Category="windows.widgets">
       Tells the shell "this package provides widgets" so BiFlow shows up
       in the board's "Add a widget" (+) menu.

    2. <Extensions> -> <com:Extension Category="windows.comServer">
       Registers the out-of-process COM class the widget host activates
       to fetch Adaptive Card content.

  Windows 10: this package has a MinVersion of 10.0.17763.0, so it
  installs on Windows 10 1809 and later. It is inert there - Windows 10
  has no Widgets Board, so the shell never activates the COM class and
  the provider never runs. The BiFlow desktop app is an independent
  NSIS installer and does not depend on this package existing.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 com rescap">

  <Identity
    Name="IranSplit.BiFlow.WidgetProvider"
    Publisher="CN=BiFlow"
    Version="0.0.0.0" />

  <Properties>
    <DisplayName>BiFlow</DisplayName>
    <PublisherDisplayName>BiFlow</PublisherDisplayName>
    <Description>Live BiFlow split-tunnel status and traffic totals on the Windows 11 Widgets Board.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!--
      Application is declared as `windows.appExtension` rather than
      `windows.app`: a widget provider is a headless extension host, not
      a launchable app. The user never sees this in the Start menu.
    -->
    <Application Id="BiFlowWidgetProvider"
                 Executable="BiFlow.WidgetProvider.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <Extensions>

        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer
              Executable="BiFlow.WidgetProvider.exe"
              Arguments=""
              DisplayName="BiFlow Widget Provider">
              <com:Class Id="7B3C1A62-4F5D-4E2B-9C8A-1D6E5A9F3B47"
                        DisplayName="BiFlow Widget Provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <uap3:AppExtension Category="windows.widgets">
          <uap3:AppExtensionList>
            <uap3:Extension Id="BiFlowWidgets"
                            DisplayName="BiFlow Traffic Widgets">
              <uap3:Definition Id="BiFlow_Traffic"
                              DisplayName="BiFlow Traffic"
                              Description="Live BiFlow routing state with download and upload totals.">

                <!--
                  Each <Widget> entry is one card the user can pin. The
                  <Capabilities> list drives the sizes offered in the
                  board's gallery; the widget host rescales the same
                  Adaptive Card for each.
                -->
                <uap3:Widget
                  Id="BiFlow_Traffic"
                  DisplayName="BiFlow Traffic"
                  Description="Live BiFlow routing state with download and upload totals.">
                  <uap3:Capabilities>
                    <uap3:Capability Size="Small" />
                    <uap3:Capability Size="Medium" />
                  </uap3:Capabilities>
                </uap3:Widget>

              </uap3:Definition>
            </uap3:Extension>
          </uap3:AppExtensionList>
        </uap3:AppExtension>

      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      Loopback only. The provider reads the local Mihomo REST controller
      on 127.0.0.1 and the user's own %APPDATA%\biflow config. It needs
      no internetClient, no privateNetworkClientServer, and no
      runFullTrust beyond what an out-of-process COM server already
      requires.
    -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
