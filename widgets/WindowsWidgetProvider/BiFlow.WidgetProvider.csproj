<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BiFlow Widget Provider
    ======================

    The smallest possible companion required by the Windows 11 Widgets
    Board. BiFlow itself is a Tauri v2 app (Rust + React) and cannot
    implement `IWidgetProvider`, because that interface is a WinRT/COM
    contract that only the Windows App SDK can activate. So this project
    is a headless, UI-less Windows App SDK process that the Widgets host
    starts on demand and calls back through COM.

    It owns NO state and NO privilege. Every value it shows comes from
    the same two sources the desktop already uses:
      * %APPDATA%\biflow\config.toml   (controller endpoint + clients)
      * the local Mihomo REST controller (live counters)

    Nothing in this project requires, launches, or links against the
    BiFlow desktop executable.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BiFlow.WidgetProvider</RootNamespace>
    <AssemblyName>BiFlow.WidgetProvider</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Widget providers are COM servers, never windows. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      2.3.1 is the oldest Windows App SDK release that ships a stable
      (non-experimental) `Microsoft.Windows.Widgets.Providers` surface
      including `IWidgetProvider` and `WidgetManager`.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.3916" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Package.appxmanifest" />
  </ItemGroup>

</Project>
