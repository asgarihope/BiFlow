/target/
/node_modules/
**/node_modules/
**/dist/
/artifacts/
**/coverage/
/.idea/
/.vscode/
*.log
.DS_Store
src-tauri/gen/
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
# `packaging/staged/*` and not `packaging/staged/`: git refuses to descend into
# a fully-ignored directory, so a `!` exception underneath one can never match.
# The widget staging folder is tracked (README + .gitkeep) so the source tree
# always has the directory the bundle mapping points at; the built MSIX stays
# ignored and is dropped in by `build.ps1 -Stage`.
packaging/staged/*
!packaging/staged/windows/
packaging/staged/windows/*
!packaging/staged/windows/widget/
!packaging/staged/windows/widget/**
packaging/staged/windows/widget/*.msix
resources/rules/cache/

test-results/
apps/desktop/test-results/
test-results/.last-run.json
.claude/launch.json

# Windows widget provider build output. The projection headers, the object
# files, the signing material and the packed MSIX are all produced by
# widgets\WindowsWidgetProvider\build.ps1 and must never be committed -
# signing.pfx especially.
widgets/WindowsWidgetProvider/obj/
widgets/WindowsWidgetProvider/bin/
widgets/WindowsWidgetProvider/build/
widgets/WindowsWidgetProvider/dist/
